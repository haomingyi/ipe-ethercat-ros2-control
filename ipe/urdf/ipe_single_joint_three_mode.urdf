<?xml version="1.0"?>
<robot name="ipe_single_joint_three_mode">
  <link name="base_link"/>
  <joint name="ipe_joint" type="continuous">
    <parent link="base_link"/>
    <child link="flange_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="flange_link"/>

  <ros2_control name="IpeThreeModeSystem" type="system">
    <hardware>
      <plugin>ethercat_master/IpeThreeModeSystem</plugin>
      <param name="interface">enp130s0</param>
      <param name="zero_count">130336</param>
      <param name="direction">-1</param>
      <param name="motion_authorization">ENABLE_THREE_MODE_MOTION</param>
      <!-- 100 output turns per activation. 1200 count/10 ms is about
           27.47 flange rpm and leaves margin below the calibrated
           29.7 rpm / 3000 motor rpm protection boundary. -->
      <param name="csp_max_travel_count">26214400</param>
      <param name="csp_max_step_count">1200</param>
      <param name="csp_max_following_error_count">16384</param>
      <!-- velocity_raw and torque_raw deliberately retain the drive's raw
           units until the manufacturer conversion is verified. -->
      <param name="csv_max_raw">13107200</param>
      <param name="csv_max_step_raw">10000</param>
      <param name="csv_max_travel_count">0</param>
      <param name="cst_max_raw">300</param>
      <param name="cst_max_step_raw">1</param>
      <param name="cst_max_travel_count">0</param>
      <!-- At 100 Hz, one raw every two cycles matches the console's
           one-raw-per-20-ms CST slew. -->
      <param name="cst_slew_interval_cycles">2</param>
      <param name="rated_velocity_raw">13107200</param>
      <!-- 101:1 calibration: 13107200 raw = 3000 motor rpm = 29.703 output rpm. -->
      <param name="velocity_raw_to_rad_s">2.3731138426448658e-7</param>
    </hardware>
    <joint name="ipe_joint">
      <command_interface name="position"/>
      <command_interface name="velocity_raw"/>
      <command_interface name="torque_raw"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="velocity_raw"/>
      <state_interface name="torque_raw"/>
    </joint>
  </ros2_control>
</robot>
