<?xml version="1.0"?>
<robot name="ipe_single_joint_csp">
  <!-- Kinematics-only model. This motion-enabled file is intentionally
       separate from the default read-only URDF. -->
  <link name="base_link"/>

  <joint name="ipe_joint" type="continuous">
    <parent link="base_link"/>
    <child link="flange_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="flange_link"/>

  <ros2_control name="IpeCspSystem" type="system">
    <hardware>
      <plugin>ethercat_master/IpeCspSystem</plugin>
      <param name="interface">enp130s0</param>
      <param name="zero_count">130336</param>
      <param name="direction">-1</param>
      <!-- This literal prevents accidental reuse of the motion plugin from a
           copied read-only URDF. Controller activation remains a second,
           explicit enable action. -->
      <param name="motion_authorization">ENABLE_CSP_MOTION</param>
      <param name="max_travel_count">1000</param>
      <param name="max_step_count">10</param>
      <param name="max_following_error_count">200</param>
    </hardware>
    <joint name="ipe_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
</robot>
