# Copy this file to .env and adjust it for the target workstation.
# .env is intentionally ignored by Git.

# ROS installation
IPE_ROS_DISTRO=jazzy
IPE_ROS_SETUP=/opt/ros/jazzy/setup.bash

# EtherCAT network device. Find candidates with:
#   ip -brief link
IPE_INTERFACE=enp130s0

# Bench calibration for the connected IRGML-14-I joint
IPE_ZERO_COUNT=130336
IPE_DIRECTION=-1
IPE_VELOCITY_RAW_TO_RAD_S=2.3731138426448658e-7
